# Gemini API key (https://aistudio.google.com/apikey). Without it the agents still run on the built-in planner, with simpler chat.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_STRONG_MODEL=gemini-pro-latest

# Server (open a singleplayer world to LAN, or any offline-mode server)
MC_HOST=localhost
MC_PORT=
MC_BOT_NAME=Vesper
# All agents in the same world, comma separated (start-team.sh fills this in for you)
MC_AGENT_NAMES=
# Game mode the agents put themselves in on join (needs cheats/op): creative | survival | keep
MC_BOT_GAMEMODE=survival
# Agents pick their own work when idle (on/off), and chat with each other (on/off)
MC_AUTONOMY=on
MC_BANTER=on
