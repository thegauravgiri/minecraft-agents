# ---------------- AI ----------------
# Pick ONE provider. The easiest way is to paste just its API key below; the provider is detected from the key.
#   gemini | anthropic | openai | openrouter | groq | deepseek | xai | mistral | together | ollama | lmstudio | custom
# Without any AI the agents still run on the built-in planner, with simpler chat.
AI_PROVIDER=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Optional overrides. AI_MODEL = fast model (chat, quick decisions); AI_STRONG_MODEL = careful model (designs, scripts; "none" = only the fast one).
# Each provider has sensible defaults (see README), so leave these empty unless you want a specific model.
AI_MODEL=
AI_STRONG_MODEL=
# Local / self-hosted / any OpenAI-compatible server (vLLM, LiteLLM, Azure-style proxies...): set AI_PROVIDER=custom (or ollama / lmstudio),
# AI_BASE_URL (e.g. http://localhost:11434/v1) and AI_MODEL. AI_API_KEY works for every provider in place of the named key.
AI_BASE_URL=
AI_API_KEY=

# Server (open a singleplayer world to LAN, or any offline-mode server)
MC_HOST=localhost
MC_PORT=
MC_BOT_NAME=Vesper
# All agents in the same world, comma separated (start-team.sh fills this in for you)
MC_AGENT_NAMES=
# Game mode the agents put themselves in on join (needs cheats/op): creative | survival | keep
MC_BOT_GAMEMODE=survival
# Agents pick their own work when idle (on/off), and chat with each other (on/off)
MC_AUTONOMY=on
MC_BANTER=on
