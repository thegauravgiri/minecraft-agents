{
  "name": "minecraft-agents",
  "version": "2.14.0",
  "description": "Autonomous AI players for Minecraft that act like real teammates: they chat, pick a leader, split up big builds, fight side by side and share the skills they learn.",
  "keywords": [
    "ai-agents",
    "anthropic",
    "autonomous-agents",
    "claude",
    "game-ai",
    "gemini",
    "llm",
    "minecraft",
    "minecraft-bot",
    "mineflayer",
    "multi-agent",
    "ollama",
    "openai"
  ],
  "homepage": "https://github.com/thegauravgiri/minecraft-agents#readme",
  "bugs": {
    "url": "https://github.com/thegauravgiri/minecraft-agents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegauravgiri/minecraft-agents.git"
  },
  "license": "MIT",
  "author": "Gaurav Giri (https://github.com/thegauravgiri)",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bot.js",
    "test": "node test/acquire.test.js && node test/blueprint.test.js && node test/structure.test.js && node test/project.js && node test/learned.test.js && node test/reflex.test.js",
    "e2e": "node test/e2e/chat.js",
    "test:quick": "bash test/run-quick.sh",
    "team": "./start-team.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@google/genai": "^2.30.0",
    "dotenv": "^18.0.8",
    "minecraft-data": "^3.117.0",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-item": "^1.18.0",
    "vec3": "^0.1.10"
  }
}
